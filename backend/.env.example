# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (PostgreSQL)
# On Render: use the Internal Database URL from the Render Postgres dashboard
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/healthcare_guide?schema=public"

# Authentication
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-super-secure-jwt-secret-key"

# Groq LLM API
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Email Configuration (Gmail SMTP via App Password)
# Setup: Google Account → Security → 2-Step Verification → App Passwords → Mail → Copy 16-char password
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-gmail-app-password"

# Google OAuth & Calendar Integration
# Setup: https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client
# Scopes needed: openid, email, profile, https://www.googleapis.com/auth/calendar
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
# In production set this to: https://your-render-service.onrender.com/api/auth/google/callback
GOOGLE_REDIRECT_URI="http://localhost:5000/api/auth/google/callback"

# CORS — set to your Vercel frontend URL in production
# e.g. https://your-app.vercel.app
FRONTEND_URL="http://localhost:5173"
